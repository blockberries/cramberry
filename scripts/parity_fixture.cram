// Fixture schema used by scripts/codegen-parity-check.sh to verify
// cross-language byte-identity of code-generated encoders. Designed to
// touch every cross-language drift hotspot:
//
//   - all scalar wire types (bool, varint, svarint, fixed32, fixed64,
//     length-prefixed bytes/string)
//   - a 0-valued enum variant (cross-language default consistency)
//   - a nested message (length-prefixed body)
//   - a repeated nested message (count + length-prefix-wrapped)
//   - a map<string, scalar> (sorted-key emission)
//   - an optional pointer (Some/None handling differs by language)
package parity;

enum Status {
  STATUS_UNKNOWN = 0;
  STATUS_ACTIVE = 1;
  STATUS_RETIRED = 2;
}

message Address {
  string street = 1;
  string city = 2;
}

// Polymorphic dispatch: an Animal field carries a TypeID + concrete
// body. Each generator emits a Encode<Animal>/Decode<Animal> pair that
// matches the reflection marshaller's encodeInterface. Without this
// fixture, codegen for interface fields never gets exercised by
// codegen-parity-check, and bugs in the polymorphic path slip
// through (the first round of the polymorphism work missed exactly
// this and produced uncompilable output for all three runtimes).
message Dog {
  string name = 1;
}
message Cat {
  string name = 1;
}
interface Animal {
  130 = Dog;
  131 = Cat;
}

// Recursive type — message contains a list of itself. Each generator
// must emit a type definition that can hold its own instances; the
// parity-check confirms a small tree round-trips byte-identically.
message Tree {
  string label = 1;
  repeated Tree children = 2;
}

message Sample {
  bool active = 1;
  int32 count = 2;
  int64 amount = 3;
  string name = 4;
  bytes payload = 5;
  float64 ratio = 6;
  repeated string tags = 7;
  Status status = 8;
  Address home = 9;
  repeated Address addresses = 10;
  map[string]int32 scores = 11;
  optional string nickname = 12;
  optional int32 priority = 13;
  float32 score = 14;
  uint32 generation = 15;
  uint64 epoch = 16;
  int8 tiny = 17;
  uint8 byte_val = 18;
  int16 small = 19;
  uint16 small_unsigned = 20;
  map[int32]string id_to_name = 21;
  optional Address office = 22;
  // Fields intentionally left zero/empty in the fixture builder to
  // exercise omit-empty paths. All four runtimes should skip them.
  string empty_str = 23;
  repeated int32 empty_list = 24;
  bytes empty_bytes = 25;
  int64 zero_count = 26;
  float64 zero_ratio = 27;
  Tree forest = 28;
  // Repeated scalar with non-Bytes element wire type. Without the
  // generator's `if f.Repeated → WireType::Bytes` override, the field
  // tag would carry the element's underlying wire type (SVarint here),
  // diverging from Go's `WireBytes` and producing different bytes on
  // decode. Both Rust and TS had this bug at different times; this
  // field locks it down across all four runtimes.
  repeated int64 ratings = 29;
  // Long string whose length prefix exceeds 5 varint bytes... ish.
  // The fixture builder fills this with 20_000 bytes, requiring a
  // 3-byte varint length (`varint(20000) = 0xa0 0x9c 0x01`). Anchors
  // the multi-byte length-prefix decode path on every runtime.
  // Catches: a 32-bit-capped length-prefix reader (the recent TS
  // skipValue / readTypeRef bug) would still decode 20_000 fine,
  // but the codepath at least exercises a non-trivial varint length.
  string long_string = 30;
  // Polymorphic interface field. Each runtime emits an
  // Encode<Animal>/Decode<Animal> helper that writes
  // [type_id varint][concrete-body 0x00] inside the outer
  // length-prefix. The fixture always picks Dog (TypeID 130).
  Animal pet = 31;
}
