// Test schema for JSON serialization functionality
package jsontest;

// Status enum for testing enum JSON encoding
enum Status {
	UNKNOWN = 0;
	ACTIVE = 1;
	INACTIVE = 2;
	PENDING = 3;
}

// ScalarTypes tests all primitive scalar types
message ScalarTypes {
	bool bool_val = 1;
	int8 int8_val = 2;
	int16 int16_val = 3;
	int32 int32_val = 4;
	int64 int64_val = 5;
	uint8 uint8_val = 6;
	uint16 uint16_val = 7;
	uint32 uint32_val = 8;
	uint64 uint64_val = 9;
	float32 float32_val = 10;
	float64 float64_val = 11;
	string string_val = 12;
	bytes bytes_val = 13;
}

// RepeatedTypes tests array/slice encoding
message RepeatedTypes {
	repeated string strings = 1;
	repeated int64 ints = 2;
	repeated bool bools = 3;
}

// MapTypes tests map encoding with sorted keys
message MapTypes {
	map[string]string string_map = 1;
	map[string]int64 int_map = 2;
}

// NestedMessage tests nested message encoding
message Address {
	string street = 1;
	string city = 2;
	string zip = 3;
}

message Person {
	string name = 1;
	int32 age = 2;
	Address address = 3;
	repeated string emails = 4;
}

// RequiredFields tests required field validation
message RequiredFields {
	required int64 id = 1;
	required string name = 2;
	string optional_field = 3;
}

// OptionalPointer tests optional pointer field handling
message OptionalPointer {
	*string value = 1;
	*int64 number = 2;
}

// EnumTest tests enum encoding as string names
message EnumTest {
	Status status = 1;
	repeated Status statuses = 2;
}

// EmptyMessage tests empty message encoding
message EmptyMessage {
}

// AllZeroValues tests that all fields are included even with zero values
message AllZeroValues {
	int64 zero_int = 1;
	string zero_string = 2;
	bool zero_bool = 3;
	repeated string empty_array = 4;
}
